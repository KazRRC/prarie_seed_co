<div class="container py-5">

<h1 class="mb-4">
  Checkout
</h1>


<div class="row">

<div class="col-md-8">

<div class="card shadow">

<div class="card-header bg-success text-white">
  Order Summary
</div>


<div class="card-body">

<% @cart_items.each do |item| %>

<div class="d-flex justify-content-between mb-3">

<div>

<strong>
<%= item[:product].name %>
</strong>

<br>

Quantity:
<%= item[:quantity] %>

</div>


<div>

$<%= item[:total] %>

</div>


</div>

<hr>

<% end %>


<div class="text-end">

<p>
Subtotal:
<strong>
$<%= number_with_precision(@subtotal, precision: 2) %>
</strong>
</p>


<p>
GST:
<strong>
$<%= number_with_precision(@gst, precision: 2) %>
</strong>
</p>


<p>
PST:
<strong>
$<%= number_with_precision(@pst, precision: 2) %>
</strong>
</p>


<p>
HST:
<strong>
$<%= number_with_precision(@hst, precision: 2) %>
</strong>
</p>


<h4>
Total:
$<%= number_with_precision(@grand_total, precision: 2) %>
</h4>


</div>


</div>

</div>

</div>


<div class="col-md-4">


<div class="card shadow">

<div class="card-header">
Shipping Information
</div>


<div class="card-body">


<p>
<strong>
<%= current_customer.first_name %>
<%= current_customer.last_name %>
</strong>
</p>


<p>
<%= current_customer.street_address %>
</p>


<p>
<%= current_customer.city %>,
<%= current_customer.province.name %>
</p>


<p>
<%= current_customer.postal_code %>
</p>


<p>
<%= current_customer.country %>
</p>


</div>

</div>


<br>


<%= button_to "Proceed to Payment",
              checkout_path,
              method: :post,
              class: "btn btn-success btn-lg w-100" %>


</div>


</div>

</div>