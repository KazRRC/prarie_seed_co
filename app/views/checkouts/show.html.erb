<!-- Order Summary -->
<div class="col-lg-8">

  <div class="card shadow">

    <div class="card-header bg-success text-white">
      <h5 class="mb-0">Order Summary</h5>
    </div>

    <div class="card-body">

      <% @cart_items.each do |item| %>

        <div class="d-flex justify-content-between align-items-center mb-3">

          <div>
            <strong>
              <%= item[:product].name %>
            </strong>

            <div class="text-muted">
              Quantity: <%= item[:quantity] %>
            </div>
          </div>

          <div>
            <%= number_to_currency(item[:total]) %>
          </div>

        </div>

        <hr>

      <% end %>

      <div class="text-end">

        <p class="mb-1">
          Subtotal:
          <strong>
            <%= number_to_currency(@subtotal) %>
          </strong>
        </p>

        <% if @gst.to_d > 0 %>
          <p class="mb-1">
            GST:
            <strong>
              <%= number_to_currency(@gst) %>
            </strong>
          </p>
        <% end %>

        <% if @pst.to_d > 0 %>
          <p class="mb-1">
            PST:
            <strong>
              <%= number_to_currency(@pst) %>
            </strong>
          </p>
        <% end %>

        <% if @hst.to_d > 0 %>
          <p class="mb-1">
            HST:
            <strong>
              <%= number_to_currency(@hst) %>
            </strong>
          </p>
        <% end %>

        <hr>

        <h4>
          Total:
          <%= number_to_currency(@grand_total) %>
        </h4>

      </div>

    </div>

  </div>

</div>


<!-- Shipping Information -->
<div class="col-lg-4">

  <div class="card shadow mb-4">

    <div class="card-header">
      <h5 class="mb-0">Shipping Information</h5>
    </div>

    <div class="card-body">

      <p>
        <strong>
          <%= current_customer.first_name %>
          <%= current_customer.last_name %>
        </strong>
      </p>

      <p class="mb-1">
        <%= current_customer.street_address %>
      </p>

      <p class="mb-1">
        <%= current_customer.city %>,
        <%= current_customer.province.name %>
      </p>

      <p class="mb-1">
        <%= current_customer.postal_code %>
      </p>

      <p>
        <%= current_customer.country %>
      </p>

      <hr>

      <%= link_to "Edit Shipping Information",
                  edit_customer_registration_path,
                  class: "btn btn-outline-secondary w-100" %>

    </div>

  </div>


  <!-- Payment -->
  <div class="card shadow">

    <div class="card-header bg-success text-white">
      <h5 class="mb-0">Payment</h5>
    </div>

    <div class="card-body">

      <p class="text-muted">
        You will be securely redirected to Stripe to complete your payment.
      </p>

      <%= form_with url: checkout_path,
                    method: :post,
                    data: { turbo: false } do %>

        <button type="submit"
                class="btn btn-success btn-lg w-100">

          Proceed to Payment

        </button>

      <% end %>

    </div>

  </div>

</div>
