<%= form_with model: [:admin, @category], local: true do |f| %>

  <% if @category.errors.any? %>

    <div class="alert alert-danger">

      <ul>

        <% @category.errors.full_messages.each do |message| %>

          <li><%= message %></li>

        <% end %>

      </ul>

    </div>

  <% end %>

  <div class="mb-3">

    <%= f.label :name %>

    <%= f.text_field :name,
                     class: "form-control" %>

  </div>

  <div class="mb-3">

    <%= f.label :description %>

    <%= f.text_area :description,
                    rows: 5,
                    class: "form-control" %>

  </div>

  <%= f.submit class: "btn btn-success" %>

<% end %>