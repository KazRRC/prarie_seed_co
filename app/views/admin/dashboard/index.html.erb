<div class="row g-4">

  <div class="col-md-3">
    <div class="card shadow text-center">
      <div class="card-body">
        <h6>Products</h6>
        <h1><%= @product_count %></h1>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card shadow text-center">
      <div class="card-body">
        <h6>Categories</h6>
        <h1><%= @category_count %></h1>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card shadow text-center">
      <div class="card-body">
        <h6>Customers</h6>
        <h1><%= @customer_count %></h1>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card shadow text-center">
      <div class="card-body">
        <h6>Orders</h6>
        <h1><%= @order_count %></h1>
      </div>
    </div>
  </div>

</div>

<hr class="my-5">

<div class="row">

  <div class="col-lg-6">

    <div class="card shadow">

      <div class="card-header bg-success text-white">

        Recent Orders

      </div>

      <table class="table mb-0">

        <thead>

        <tr>

          <th>#</th>
          <th>Customer</th>
          <th>Status</th>

        </tr>

        </thead>

        <tbody>

        <% @recent_orders.each do |order| %>

          <tr>

            <td><%= order.id %></td>

            <td><%= order.customer.email %></td>

            <td>

              <span class="badge bg-primary">

                <%= order.status.titleize %>

              </span>

            </td>

          </tr>

        <% end %>

        </tbody>

      </table>

    </div>

  </div>

  <div class="col-lg-6">

    <div class="card shadow">

      <div class="card-header bg-warning">

        Low Stock Products

      </div>

      <table class="table mb-0">

        <thead>

        <tr>

          <th>Product</th>
          <th>Remaining</th>

        </tr>

        </thead>

        <tbody>

        <% @low_stock_products.each do |product| %>

          <tr>

            <td><%= product.name %></td>

            <td>

              <span class="badge bg-danger">

                <%= product.stock_quantity %>

              </span>

            </td>

          </tr>

        <% end %>

        </tbody>

      </table>

    </div>

  </div>

</div>