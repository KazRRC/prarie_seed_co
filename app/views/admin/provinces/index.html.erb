<h1 class="mb-4">Province Tax Rates</h1>

<table class="table table-striped">

<thead class="table-success">

<tr>

<th>Province</th>
<th>GST</th>
<th>PST</th>
<th>HST</th>
<th></th>

</tr>

</thead>

<tbody>

<% @provinces.each do |province| %>

<tr>

<td><%= province.name %></td>

<td><%= province.gst_rate %>%</td>

<td><%= province.pst_rate %>%</td>

<td><%= province.hst_rate %>%</td>

<td>

<%= link_to "Edit",
            edit_admin_province_path(province),
            class: "btn btn-warning btn-sm" %>

</td>

</tr>

<% end %>

</tbody>

</table>