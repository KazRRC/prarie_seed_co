<div class="col">
  <div class="card product-card h-100">

    <% if product.image.attached? %>

      <%= image_tag product.image.variant(resize_to_fill: [300, 200]),
                    class: "card-img-top product-card-image",
                    alt: product.name %>

    <% elsif product.image_url.present? %>

      <%= image_tag product.image_url,
                    class: "card-img-top product-card-image",
                    alt: product.name %>

    <% else %>

      <%= image_tag "placeholder.png",
                    class: "card-img-top product-card-image",
                    alt: "No image available" %>

    <% end %>

    <div class="card-body d-flex flex-column">

      <h5 class="card-title">
        <%= product.name %>
      </h5>

      <p class="card-text text-muted">
        <%= truncate(product.description, length: 100) %>
      </p>

      <% if product.on_sale? && product.sale_price.present? %>

        <div class="product-price mb-3">

          <span class="text-muted text-decoration-line-through">
            $<%= number_with_precision(product.price, precision: 2) %>
          </span>

          <span class="text-danger fw-bold ms-2">
            $<%= number_with_precision(product.sale_price, precision: 2) %>
          </span>

          <span class="badge bg-danger ms-2">
            <%= product.discount_percentage %>% OFF
          </span>

        </div>

      <% else %>

        <p class="fw-bold mb-3">
          $<%= number_with_precision(product.price, precision: 2) %>
        </p>

      <% end %>

      <div class="mt-auto">

        <%= link_to "View Product",
                    product_path(product),
                    class: "btn btn-success w-100" %>

      </div>

    </div>

  </div>
</div>