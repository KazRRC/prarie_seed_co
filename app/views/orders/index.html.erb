<div class="container py-5">

<h1>My Orders</h1>

<table class="table">

<thead>

<tr>

<th>ID</th>

<th>Date</th>

<th>Status</th>

<th>Total</th>

<th></th>

</tr>

</thead>

<tbody>

<% @orders.each do |order| %>

<tr>

<td>#<%= order.id %></td>

<td><%= order.created_at.strftime("%B %d, %Y") %></td>

<td><%= order.status.titleize %></td>

<td>$<%= sprintf("%.2f", order.total) %></td>

<td>

<%= link_to "View",
            order_path(order),
            class: "btn btn-primary btn-sm" %>

</td>

</tr>

<% end %>

</tbody>

</table>

</div>